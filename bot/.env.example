# Semua OPSIONAL. Tanpa file .env bot tetap jalan: kunci dibuat otomatis (data/config.json)
# dan nomor yang ditautkan ke bot otomatis menjadi pemilik.
BOT_NAME=Shin Bot
PREFIX=.
OWNER_NAME=Shin Von Reinhaver
# Isi bila pemilik berbeda dari nomor bot (internasional tanpa +, pisahkan koma)
OWNER_NUMBER=
# Kunci API / login panel (min. 16 karakter). Kosong = dibuat otomatis
OWNER_TOKEN=
PORT=3000
# Alamat situs index.html (mis. https://situsmu.netlify.app) agar link koneksi mengarah ke sana
PANEL_URL=
# Alamat publik bot bila di belakang domain/proxy
PUBLIC_URL=
# Nomor bot untuk kode tautan otomatis (tanpa QR). Kosong = ditanya di terminal
PAIR_NUMBER=
# 0 = jangan buka panel otomatis di browser (Termux)
OPEN_BROWSER=1
# 1 = buat alamat HTTPS gratis lewat Cloudflare (butuh cloudflared)
TUNNEL=0
# Batasi situs yang boleh memanggil API. * = semua
ALLOWED_ORIGIN=*
# 1 = server ini juga menyajikan index.html dan folder tools
SERVE_STATIC=1
STICKER_PACK=Shin Bot
STICKER_AUTHOR=Shin Von Reinhaver
